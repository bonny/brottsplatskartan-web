}

# Produktionsdomäner

# www → apex redirect
www.brottsplatskartan.se {
	redir https://brottsplatskartan.se{uri} permanent
}

brottsplatskartan.se {
	# Döda kartbilds-URL:er från en tidigare URL-struktur, t.ex.
	# /12/100x100.jpg?latlng=1&path=... och /stockholms-lan/12/100x100@2x.jpg.
	# Bingbot crawlar dem i massor och varje träff renderade en full 43 KB
	# Laravel-404 — alltså en php-fpm-worker per skräprequest. Det bidrog
	# till nedtiden 2026-08-03 21:00 (poolen tog slut, listen-kön svämmade
	# över). Svaras nu i Caddy: inget Laravel-anrop alls.
	#
	# 410 i stället för 404 — URL:erna är permanent borta, och sökmotorer
	# slutar fråga snabbare på 410. Nuvarande kartbilds-route är
	# /k/v1/{spec}.jpg (routes/web.php) och matchas inte av regexen:
	# den kräver siffror i näst sista segmentet och NNNxNNN i filnamnet.
	@dodaKartbilder path_regexp doda_kartbilder ^(/[a-z0-9-]+)?/\d+/\d+x\d+(@2x)?\.jpg$
	respond @dodaKartbilder 410

	reverse_proxy app:8080 {
		# Skriv ÖVER X-Forwarded-For i stället för att lägga till.
		# Caddy default-beteende är att appenda, och eftersom Laravel
		# litar på alla proxyer (TrustProxies::$proxies = '*') plockade
		# Symfony då den vänstra — alltså klientens egen, spoofbara,
		# header. Följden var att request()->ip() var angriparstyrd och
		# all IP-baserad rate limiting kunde kringgås med en godtycklig
		# X-Forwarded-For, inklusive login-throttlingen. Caddy är edge
		# (ingen CDN framför), så {remote_host} är den verkliga
		# klient-IP:n. Se todo #100.
		header_up X-Forwarded-For {remote_host}
	}
	encode gzip zstd
	# Security headers sätts av serversideup/php nginx (security.conf) —
	# dubblera inte här. X-Frame-Options sätts också där.
}

kartbilder.brottsplatskartan.se {
	reverse_proxy nginx-tiles:80
	encode gzip zstd
	# Aggressiv cache — tiles ändras sällan
	header Cache-Control "public, max-age=604800, immutable"
}

# Drop-in för co-hostade externa sajter — varje sajt levererar sin egen
# *.caddy från sitt repo via GitHub Actions till /opt/caddy-sites.d/ på
# servern. BPK-repot vet inget om vilka sajter som finns.
# Se deploy/co-hosted-static-sites.md.
import /etc/caddy/sites.d/*.caddy
