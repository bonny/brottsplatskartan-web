# Tileserver-data (mbtiles laddas ner vid provisionering, ~2.4 GB).
# Hela mappen är genererat state — inget där ska committas.
/deploy/tileserver/*
!/deploy/tileserver/.gitkeep

# DB-dumpar ska aldrig committas
*.sql
*.sql.gz
*.dump
*.dump.gz
bpk*.gz

# Laravel Pail dev-logger
/storage/pail/

# Arbetskatalog för mbtiles-uppdatering (pbf + planetiler-cache + output)
/tmp-maps/

# Lokal dump-mapp för research/diagnostics (CWV-mätningar, GSC-rapporter,
# m.fl.) — behålls så länge disk räcker så vi kan jämföra mot framtida data.
# README behålls i git så mappens syfte är dokumenterat.
/tmp-cwv/*
!/tmp-cwv/README.md
